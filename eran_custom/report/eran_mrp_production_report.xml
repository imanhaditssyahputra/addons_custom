<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="mrp.report_mrp_production_components">
        <h3>
            <span>
                Components
            </span>
        </h3>
        <table class="table table-sm">
            <t t-set="has_product_barcode" t-value="any(m.product_id.barcode for m in o.move_raw_ids)"/>
            <thead>
                <tr>
                    <th style="width:37%;">Product</th>
                    <th>Reserved</th>
                    <th>Available Stock</th>
                    <!-- <th t-if="o.state in ('progress', 'to_close','done')" t-attf-class="{{ 'text-end' if not has_product_barcode else '' }}">Consumed</th> -->
                    <th t-attf-class="{{ 'text-end' if not has_product_barcode else '' }}">Plan Supply</th>
                    <th>Actual Supply</th>
                    <th t-if="has_product_barcode" width="15%" class="text-center">Barcode</th>
                </tr>
            </thead>
            <tbody>
                <tr t-foreach="o.move_raw_ids" t-as="raw_line">
                    <!-- cari stock avaliable di stock quant -->
                    <t t-set="available_stock" t-value="o.env['stock.quant'].search([('product_id', '=', raw_line.product_id.id), ('location_id', '=', raw_line.location_id.id)])"/>
                    <t t-set="qty_available" t-value="0"/>
                    <t t-foreach="available_stock" t-as="val">
                        <t t-set="qty_available" t-value="qty_available + val.quantity"/>
                    </t>
                    <!-- cari total actual supply dari request material -->
                    <t t-set="move_ids" t-value="o.env['stock.move'].search([('picking_id.manufacture_production_id', '=', o.id), ('picking_id.state', '!=', 'cancel'), ('product_id', '=', raw_line.product_id.id)])"/>
                    <t t-set="qty_actual" t-value="0"/>
                    <t t-foreach="move_ids" t-as="value">
                        <t t-set="qty_actual" t-value="qty_actual + value.quantity_done"/>
                    </t>
                    <!--Cari Reserved quantity components-->
                    <t t-set="reserve_qty" t-value="0"/>
                    <t t-set="move_raw" t-value="o.env['stock.move'].search([('product_id', '=', raw_line.product_id.id), ('state', '=', 'assigned'), ('raw_material_production_id', '!=', False)])"/>
                    <t t-foreach="move_raw" t-as="val">
                        <t t-set="reserve_qty" t-value="reserve_qty + val.product_uom_qty"/>
                    </t>
                    
                    <t t-set="available_stock_qty" t-value="qty_available - reserve_qty"/>
                    <td>
                        <span t-field="raw_line.product_id"/>
                    </td>
                    <td><span t-esc="reserve_qty" t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 2}"/> <span t-field="raw_line.product_uom" groups="uom.group_uom"/></td>
                    <td><span t-esc="available_stock_qty" t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 2}"/> <span t-field="raw_line.product_id.uom_id" groups="uom.group_uom"/></td>
                    <!-- <td t-attf-class="{{ 'text-end' if not has_product_barcode else '' }}" t-if="o.state in ('progress', 'to_close','done')">
                        <div>
                            <span t-field="raw_line.quantity_done"/>
                        </div>
                    </td> -->
                    <td t-attf-class="{{ 'text-end' if not has_product_barcode else '' }}">
                        <span t-field="raw_line.product_uom_qty"/>
                        <span t-field="raw_line.product_uom" groups="uom.group_uom"/>
                    </td>
                    <!-- <td><span t-esc="qty_actual" t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 2}"/> <span t-field="raw_line.product_uom" groups="uom.group_uom"/></td> -->
                    <td><span t-esc="qty_actual" t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 2}"/> <span t-field="raw_line.product_id.uom_id" groups="uom.group_uom"/></td>
                    <td t-if="has_product_barcode" width="15%" class="text-center">
                        <t t-if="raw_line.product_id.barcode">
                            <div t-field="raw_line.product_id.barcode" t-options="{'widget': 'barcode', 'width': 600, 'height': 100, 'img_style': 'width:100%;height:35px'}"/>
                        </t>
                    </td>
                </tr>
            </tbody>
        </table>
    </template>

    <template id="eran_report_mrporder_large_barcode" inherit_id="mrp.report_mrporder">
        <xpath expr="//t[@t-call='web.internal_layout']" position="attributes">
            <attribute name="t-call">web.basic_layout</attribute>
        </xpath>
        <xpath expr="//div[hasclass('page')]" position="replace">
            <div class="page" style="font-family:DejaVu Sans,Arial,sans-serif;font-size:11px;color:#000;">
                <t t-set="wo" t-value="o.workorder_ids[:1]"/>
                <style>
                    .page { page-break-after: auto !important; }
                    .eran-wo-box { border:1.5px solid #000; padding:6px 8px; margin-bottom:10px; page-break-inside: avoid; }
                    .eran-wo-title { text-align:center; font-size:16px; font-weight:700; letter-spacing:1px; margin:0 0 6px 0; }
                    .eran-wo-head td { border:none; padding:0; vertical-align:middle; }
                    .eran-barcode { display:inline-block; padding:0 2px 0 6px; }
                    .eran-info td { border:none; padding:1px 4px; vertical-align:top; font-size:10px; }
                    .eran-info .lbl { width:110px; }
                    .eran-info .sep { width:10px; }
                    .eran-grid { width:100%; border-collapse:collapse; margin-top:6px; }
                    .eran-grid th, .eran-grid td { border:1px solid #000; padding:3px 5px; }
                    .eran-grid th { text-align:center; font-size:10px; }
                </style>

                <!-- WORK ORDER -->
                <div class="eran-wo-box">
                    <div class="eran-wo-title">WORK ORDER</div>
                    <table style="width:100%;margin-bottom:4px;">
                        <tr class="eran-wo-head">
                            <td style="width:78%;font-size:15px;font-weight:700;white-space:nowrap;padding-right:8px;">
                                <span t-field="o.name"/>
                            </td>
                            <td style="width:22%;text-align:right;">
                                <div class="eran-barcode">
                                    <div t-esc="o.name" t-options="{'widget': 'barcode', 'symbology': 'QR', 'width': 160, 'height': 160, 'quiet': 1, 'img_style': 'width:64px;height:64px;'}"/>
                                </div>
                            </td>
                        </tr>
                    </table>
                    <table class="eran-info" style="width:100%;">
                        <tr>
                            <td class="lbl">Production Date</td><td class="sep">:</td>
                            <td><span t-field="o.date_planned_start"/></td>
                            <td class="lbl">Leader</td><td class="sep">:</td>
                            <td><span t-field="o.leader_id"/></td>
                        </tr>
                        <tr>
                            <td class="lbl">Shift</td><td class="sep">:</td>
                            <td><span t-field="o.shift_id"/></td>
                            <td class="lbl">Operator</td><td class="sep">:</td>
                            <td><span t-field="o.operator_id"/></td>
                        </tr>
                        <tr>
                            <td class="lbl">Machine</td><td class="sep">:</td>
                            <td><span t-field="wo.workcenter_id"/></td>
                            <td class="lbl">Duration</td><td class="sep">:</td>
                            <td>
                                <span t-esc="int(sum(o.workorder_ids.mapped('duration_expected')) or 0)"/> Minutes
                            </td>
                        </tr>
                    </table>
                    <table class="eran-grid">
                        <thead>
                            <tr>
                                <th style="width:8%;">No</th>
                                <th>Material Description</th>
                                <th style="width:12%;">Plan Qty</th>
                                <th style="width:12%;">Actual Qty</th>
                                <th style="width:10%;">UoM</th>
                                <th style="width:14%;">Remark</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td style="text-align:center;">1</td>
                                <td><span t-field="o.product_id.display_name"/></td>
                                <td style="text-align:center;"><span t-field="o.product_qty"/></td>
                                <td style="text-align:center;"><span t-esc="o.qty_producing or o.qty_produced or 0"/></td>
                                <td style="text-align:center;"><span t-field="o.product_uom_id"/></td>
                                <td></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </xpath>
    </template>

    <template id="eran_report_mrp_workorder_mo_barcode" inherit_id="mrp.report_mrp_workorder">
        <xpath expr="//div[hasclass('page')]/div[hasclass('row')][1]" position="replace">
            <table style="width:100%;margin-bottom:12px;border:none;">
                <tr>
                    <td style="vertical-align:middle;padding:0;border:none;width:55%;">
                        <div style="font-size:22px;font-weight:700;line-height:1.2;white-space:nowrap;">
                            <span t-field="o.name"/>
                        </div>
                    </td>
                    <td style="vertical-align:middle;padding:0;border:none;width:45%;text-align:right;">
                        <div t-esc="o.production_id.name" t-options="{'widget': 'barcode', 'symbology': 'QR', 'width': 200, 'height': 200, 'quiet': 1, 'img_style': 'width:72px;height:72px;'}"/>
                    </td>
                </tr>
            </table>
        </xpath>
    </template>

</odoo>
