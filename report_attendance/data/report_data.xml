<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="action_report_attendance_report_html" model="ir.actions.client">
        <field name="name">Report Attendance</field>
        <field name="tag">attendance_report_backend</field>
        <field name="context" eval="{'active_model': 'report.attendance.report'}" />
    </record>

    <record id="action_attendance_report_pdf" model="ir.actions.report">
        <field name="name">Attendance Report PDF</field>
        <field name="model">report.attendance.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">report_attendance.report_attendance_report_pdf</field>
        <field name="report_file">report_attendance.report_attendance_report_pdf</field>
        <field name="print_report_name">
            'Laporan Rekapitulasi Absensi Karyawan - Periode %s sd %s' % (
                object.date_from and object.date_from.strftime('%d-%m-%Y') or 'Awal',
                object.date_to and object.date_to.strftime('%d-%m-%Y') or 'Sekarang'
            )
        </field>
        <field name="paperformat_id" ref="report_attendance.paperformat_report_attendance_global" />
    </record>

    <record id="action_attendance_report_xlsx" model="ir.actions.report">
        <field name="name">Attendance Report XLSX</field>
        <field name="model">report.attendance.report</field>
        <field name="report_type">xlsx</field>
        <field name="report_name">report_attendance.report_attendance_report_xlsx</field>
        <field name="report_file">Attendance Report</field>
    </record>

</odoo>
